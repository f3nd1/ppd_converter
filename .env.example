# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Values are intentionally left empty here.

# --- Server ---
NODE_ENV=production
HOST=127.0.0.1
PORT=4020

# --- Google OAuth (Phase 3 — not needed to run the Phase 1 skeleton) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ALLOWED_GOOGLE_EMAIL=

# --- Encryption for the stored OAuth refresh token (Phase 3) ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Session cookie secret (Phase 3) ---
# At least 32 characters. Generate the same way as above.
SESSION_SECRET=

# --- OpenAI (Phase 8) ---
# OPENAI_MODEL must be GPT-5 family or later. No model name is hardcoded in source.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
